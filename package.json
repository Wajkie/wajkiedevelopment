{
  "name": "wajkiedev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:up": "tsx src/lib/migrate.ts up",
    "migrate:down": "tsx src/lib/migrate.ts down",
    "seed:posts": "node --use-system-ca --import tsx scripts/seed-posts.ts",
    "type-coverage": "type-coverage",
    "type-coverage:detail": "type-coverage --detail",
    "analyze": "npm run analyze:circular && npm run analyze:duplicates",
    "analyze:circular": "madge --circular --extensions ts,tsx src/",
    "analyze:duplicates": "jscpd src/",
    "analyze:graph": "madge --image dependency-graph.svg src/",
    "analyze:complexity": "madge --warning 10 src/",
    "a11y": "node scripts/test-a11y.js",
    "a11y:ci": "start-server-and-test dev http://localhost:3000 a11y",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.0.0",
    "@wajkie/a11y-core": "^1.0.0",
    "@wajkie/react-a11y": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "iron-session": "^8.0.4",
    "kysely": "^0.28.9",
    "kysely-ctl": "^0.20.0",
    "next": "16.1.1",
    "octokit": "^5.0.5",
    "otplib": "^13.1.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "jscpd": "^4.0.7",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "pa11y": "^9.0.1",
    "pa11y-ci": "^4.0.1",
    "start-server-and-test": "^2.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5"
  }
}
