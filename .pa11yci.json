{
  "defaults": {
    "timeout": 10000,
    "wait": 1000,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox"]
    },
    "standard": "WCAG2AA",
    "runners": ["axe", "htmlcs"],
    "ignore": [
      "color-contrast"
    ]
  },
  "urls": [
    "http://localhost:3000",
    "http://localhost:3000/about",
    "http://localhost:3000/projects",
    "http://localhost:3000/blog",
    "http://localhost:3000/testimonials",
    "http://localhost:3000/testimonials/submit"
  ]
}
